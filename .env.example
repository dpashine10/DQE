# Copy this file to .env and fill in an OpenAI-compatible provider.
LLM_API_KEY=your-api-key
LLM_ENDPOINT=https://provider.example/v1/chat/completions
LLM_MODEL=your-model-name
# Optional: LLM_TIMEOUT_SECONDS=90
# Optional: LLM_MAX_TOKENS=12000
# Optional JSON headers: LLM_EXTRA_HEADERS={"HTTP-Referer":"https://your-app.example"}

# Optional role-specific providers for notebook generation.
# Each role falls back to the base LLM_* values when omitted.
# AGENT_RESEARCH_PROVIDER=openai_compatible
# AGENT_RESEARCH_API_KEY=research-key
# AGENT_RESEARCH_ENDPOINT=https://provider.example/v1/chat/completions
# AGENT_RESEARCH_MODEL=research-model
# AGENT_INSIGHTS_PROVIDER=openai_compatible
# AGENT_INSIGHTS_API_KEY=insights-key
# AGENT_INSIGHTS_ENDPOINT=https://provider.example/v1/chat/completions
# AGENT_INSIGHTS_MODEL=insights-model
# AGENT_PRIMARY_PROVIDER=openai_compatible
# AGENT_PRIMARY_API_KEY=primary-key
# AGENT_PRIMARY_ENDPOINT=https://provider.example/v1/chat/completions
# AGENT_PRIMARY_MODEL=primary-model
# AGENT_CODE_PROVIDER=openai_compatible
# AGENT_CODE_API_KEY=code-key
# AGENT_CODE_ENDPOINT=https://provider.example/v1/chat/completions
# AGENT_CODE_MODEL=code-model
